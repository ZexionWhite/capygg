generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Guild {
  id              String   @id
  verifyChannelId String?
  verifyMessageId String?
  reportChannelId String?
  createdAt       DateTime @default(now())
}

model GuildRole {
  id      Int    @id @default(autoincrement())
  guildId String
  key     String
  kind    String
  roleId  String

  @@unique([guildId, key])
}

model RiotAccount {
  puuid          String   @id
  discordId      String   @unique
  gameName       String
  tagLine        String
  region         String
  profileIconId  Int?
  summonerLevel  Int?
  linkedAt       DateTime @default(now())
  masterySyncedAt DateTime?
  matchesSyncedAt DateTime?
  matchHistoryBackfilledAt DateTime?
  championMasteries ChampionMastery[]
}

model RankSnapshot {
  id        Int      @id @default(autoincrement())
  puuid     String
  queue     String
  tier      String
  division  String
  lp        Int
  wins      Int
  losses    Int
  createdAt DateTime @default(now())
}

model VerificationChallenge {
  id             Int      @id @default(autoincrement())
  discordId      String
  guildId        String
  puuid          String
  gameName       String
  tagLine        String
  region         String
  requiredIconId Int
  expiresAt      DateTime
  startedAt      DateTime?
  nextCheckAt    DateTime?
  attempts       Int      @default(0)
  createdAt      DateTime @default(now())
}

model ErrorReport {
  id          Int      @id @default(autoincrement())
  guildId     String
  discordId   String
  category    String
  description String
  reference   String?
  createdAt   DateTime @default(now())
}

model AuditLog {
  id             Int      @id @default(autoincrement())
  guildId        String
  actorDiscordId String
  action         String
  details        String
  createdAt      DateTime @default(now())
}


model ChampionMastery {
  id                    Int         @id @default(autoincrement())
  puuid                 String
  championId            Int
  championLevel         Int
  championPoints        Int
  lastPlayTime          DateTime?
  championPointsSinceLevel Int
  championPointsUntilNextLevel Int
  tokensEarned          Int
  chestGranted          Boolean?
  updatedAt             DateTime    @updatedAt
  account               RiotAccount @relation(fields: [puuid], references: [puuid], onDelete: Cascade, onUpdate: Cascade)

  @@unique([puuid, championId])
  @@index([puuid, championPoints])
  @@index([championId, championPoints])
}

model MatchRecord {
  matchId             String              @id
  region              String
  queueId             Int
  queueLabel          String
  gameMode            String
  gameType            String?
  mapId               Int?
  gameStartTimestamp  DateTime
  gameDuration        Int
  gameVersion         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  participants        MatchParticipant[]

  @@index([gameStartTimestamp])
  @@index([queueId, gameStartTimestamp])
}

model MatchParticipant {
  id             Int         @id @default(autoincrement())
  matchId        String
  puuid          String
  summonerName   String?
  riotIdGameName String?
  riotIdTagLine  String?
  championId     Int
  championName   String
  teamId         Int?
  teamPosition   String?
  individualPosition String?
  win            Boolean
  kills          Int
  deaths         Int
  assists        Int
  champLevel     Int?
  totalDamageDealtToChampions Int?
  visionScore    Int?
  item0          Int?
  item1          Int?
  item2          Int?
  item3          Int?
  item4          Int?
  item5          Int?
  item6          Int?
  placement      Int?
  match          MatchRecord @relation(fields: [matchId], references: [matchId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([matchId, puuid])
  @@index([puuid, matchId])
  @@index([puuid, championId])
}
